# 10.20.0.0/24     networking gear:
#            1        router, static IP since runs DHCP
#            2        access point (old router). Assigned using DHCP fixed lease.
# 10.20.1.0/24     statically configured things:
#            2        homeassistant (virtual server)
#            3        warthog (physical server)
#            4        printer (HP 5010 keeps trying to use 192.168.1.x/24)
# 10.20.2.0/24     DHCP reservations (e.g. hoover, smart light hub) which use
#                    DHCP but are given fixed addresses
# 10.20.3.0/24     open season, DHCP dynamic assignment space
# 10.20.4.0/24     docker, if I can work out how to get it to allocate real
#                    IPs for some containers.
# 10.20.5.0/24     VPN devices.

config dnsmasq
	option domainneeded '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option authoritative '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '1'
	option ednspacket_max '1232'
	list address '/warthog.keith.collister.xyz/10.20.1.3'
	list address '/warthog.keith.collister.xyz/fdf3:685c:acae::2a2'
	list address '/ha.keith.collister.xyz/10.20.1.3'
	list address '/ha.keith.collister.xyz/fdf3:685c:acae::2a2'
	list address '/lan/10.20.1.3'
	list address '/lan/fdf3:685c:acae::2a2'
	list server '10.20.1.3#53'
	list server 'fdf3:685c:acae::2a2#53'

config dhcp 'lan'
	option interface 'lan'
	option start '770'
	option limit '253'
	option leasetime '12h'
	option dhcpv4 'server'
	option dhcpv6 'server'
	option ra 'server'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	# Allow routing to docker containers via server
        #list dhcp_option '121,10.20.4.0/24,10.20.1.3'
	#list dhcp_option '121,2a02:169:5bef:d0ca::/64,2a02:169:5bef::2a2'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config boot 'linux'
	option filename 'netboot.xyz.efi'
	option serveraddress '10.20.1.3'
	option servername 'warthog'

# Hack for if restoring a home assistant backup: give the new vm the right IP
# before we get a chance to set the IP statically.
config host
	option name 'homeassistant'
	option mac '52:54:00:D6:0B:F4'
	option ip '10.20.1.2'

config host
	option name 'access-point'
	option mac '10:0C:6B:33:63:FB'
	option ip '10.20.0.2'

config host
	option name 'hoover'
	option mac '50:EC:50:03:26:D9'
	option ip '10.20.2.10'

config host
	option name 'phillips-bridge'
	option mac 'EC:B5:FA:80:77:5F'
	option ip '10.20.2.11'

config host
