/attendedsysupgrade
/dhcp
/dropbear
/firewall
/fstab
/luci
/network
/packages
/system
/ubihealthd
/uhttpd
/wireless

/secrets.toml

# These aren't filled out by `sync.py`, but also aren't tracked by git because they're not interesting.
/rpcd

