
config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

config globals 'globals'
    option packet_steering '1'
    #option ula_prefix 'fdf3:685c:acae::/48'

config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'lan2'
    list ports 'lan3'
    list ports 'lan4'
    list ports 'lan5'
    list ports 'wan'
    # On Init7 with Hex S there are weird occasional network drops when
    # using IPv6. Still need to finish debugging.
    option ipv6 '0'

config device
    option name 'lan2'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'lan3'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'lan4'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'lan5'
    option macaddr 'dc:2c:6e:02:6b:06'

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ip6assign '60'
    option ipaddr '10.20.0.1'
    option netmask '255.255.0.0'
    list ip6class 'local'

config device
    option name 'br-wan'
    option type 'bridge'
    list ports 'sfp'

config device
    option name 'wan'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'sfp'
    option macaddr 'dc:2c:6e:02:6b:05'

config interface 'wan'
    option device 'br-wan'
    option proto 'dhcp'

config interface 'wan6'
    option device 'br-wan'
    option proto 'dhcpv6'

config interface 'wg0'
    option proto 'wireguard'
    option private_key '${wireguard_private_key}'
    option listen_port '5746'
    list allowed_ips '10.20.69.1/16'

config wireguard_wg0 'corp_laptop'
    option description 'Corp Laptop'
    option public_key '${wireguard_corp_laptop_public_key}'
    list allowed_ips '10.20.69.1/32'
    option route_allowed_ips '1'

config wireguard_wg0 'personal_phone'
    option description 'Personal phone'
    option public_key '${wireguard_personal_phone_public_key}'
    list allowed_ips '10.20.69.3/32'
    option route_allowed_ips '1'

config wireguard_wg0 'corp_phone'
    option description 'Corp Phone'
    option public_key '${wireguard_corp_phone_public_key}'
    list allowed_ips '10.20.69.5/32'
    option route_allowed_ips '1'

config wireguard_wg0 'rosies_pi'
    option description "Rosie's Pi"
    option public_key '${wireguard_rosies_pi_public_key}'
    list allowed_ips '10.20.69.6/32'
    option route_allowed_ips '1'

