
config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

config globals 'globals'
    option packet_steering '1'
    option ula_prefix 'fdf3:685c:acae::/48'

config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'lan2'
    list ports 'lan3'
    list ports 'lan4'
    list ports 'lan5'
    option ipv6 '1'

config device
    option name 'lan2'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'lan3'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'lan4'
    option macaddr 'dc:2c:6e:02:6b:06'

config device
    option name 'lan5'
    option macaddr 'dc:2c:6e:02:6b:06'

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '10.20.0.1'
    option netmask '255.255.0.0'
    # Setting DNS here enforces captive DNS, but also means if the server
    # is down there's no DNS resolution. For now, I'll take availability.
    #list dns '10.20.1.3'
    option ip6assign '60'
    # Only assign local ipv6 addresses.
    #list ip6class 'local'

config device
    option name 'br-wan'
    option type 'bridge'
    list ports 'sfp'
    list ports 'wan'

config device
    option name 'wan'
    # MAC is important because it's allowlisted by ISP.
    option macaddr '${wan_ethernet_mac_address}'

config device
    option name 'sfp'
    option macaddr 'dc:2c:6e:02:6b:05'

config interface 'wan'
    option device 'br-wan'
    option proto 'dhcp'
    # Setting DNS here enforces captive DNS, but also means if the server
    # is down there's no DNS resolution. For now, I'll take availability.
    #option peerdns '0'
    #list dns '10.20.1.3'

config interface 'wan6'
    option device 'br-wan'
    option proto 'dhcpv6'
    #option peerdns '0'

# For docker containers
#config route
#        option target '10.21.0.0/16'
#        option gateway '10.20.1.3'
#    option interface 'lan'

config interface 'wg0'
    option proto 'wireguard'
    option private_key '${wireguard_private_key}'
    option listen_port '5746'
    list allowed_ips '10.29.0.0/24'
    list addresses '10.29.0.1/24'

config wireguard_wg0 'corp_laptop'
    option description 'Corp Laptop'
    option public_key '${wireguard_corp_laptop_public_key}'
    list allowed_ips '10.29.0.2/32'
    option route_allowed_ips '1'

config wireguard_wg0 'personal_phone'
    option description 'Personal Phone'
    option public_key '${wireguard_personal_phone_public_key}'
    list allowed_ips '10.29.0.3/32'
    option route_allowed_ips '1'

config wireguard_wg0 'corp_phone'
    option description 'Corp Phone'
    option public_key '${wireguard_corp_phone_public_key}'
    list allowed_ips '10.29.0.5/32'
    option route_allowed_ips '1'

config wireguard_wg0 'parents_house'
    option description "Parent's House"
    option public_key '${wireguard_parents_house_public_key}'
    list allowed_ips '10.29.0.7/32'
    option route_allowed_ips '1'

config wireguard_wg0 'parents_display_pi'
    option description "Parent's Display Pi"
    option public_key '${wireguard_parents_display_pi_public_key}'
    list allowed_ips '10.29.0.8/32'
    option route_allowed_ips '1'

config wireguard_wg0 'personal_laptop'
    option description "Personal Laptop"
    option public_key '${wireguard_personal_laptop_public_key}'
    list allowed_ips '10.29.0.9/32'
    option route_allowed_ips '1'

