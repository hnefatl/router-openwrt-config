
config interface 'loopback'
    option device 'lo'
    option proto 'static'
    list ipaddr '127.0.0.1/24'

config globals 'globals'
    option packet_steering '1'

config device
    option name 'br-lan'
    option type 'bridge'
    option ipv6 '1'
    list ports 'wan'
    list ports 'lan1'
    list ports 'lan2'
    list ports 'lan3'
    list ports 'lan4'

config bridge-vlan
    option device 'br-lan'
    option vlan '1'
    list ports 'wan:t'

config bridge-vlan
    option device 'br-lan'
    option vlan '10'
    list ports 'wan:t'
    list ports 'lan1:u*'
    list ports 'lan2:u*'
    list ports 'lan3:u*'
    list ports 'lan4:u*'

config bridge-vlan
    option device 'br-lan'
    option vlan '20'
    list ports 'wan:t'

config interface 'core'
    option device 'br-lan.1'
    option proto 'static'
    list ipaddr '10.20.0.4/24'
    option gateway '10.20.0.1'
    list ip6addr 'fdf3:685c:acae:1::4/64'
    list ip6addr '2a01:4b00:bd20:7001::4/64'
    list dns 'fdf3:685c:acae:1::1'

config interface 'trusted'
    option proto 'static'
    option device 'br-lan.10'
    list ipaddr '10.20.10.4/24'
    option gateway '10.20.10.1'
    list ip6addr 'fdf3:685c:acae:10::4/64'
    list ip6addr '2a01:4b00:bd20:7010::4/64'
    list dns 'fdf3:685c:acae:10::1'

config interface 'untrusted'
    option proto 'static'
    option device 'br-lan.20'
    list ipaddr '10.20.20.4/24'
    option gateway '10.20.20.1'
    list ip6addr 'fdf3:685c:acae:20::4/64'
    list ip6addr '2a01:4b00:bd20:7020::4/64'
    list dns 'fdf3:685c:acae:20::1'
