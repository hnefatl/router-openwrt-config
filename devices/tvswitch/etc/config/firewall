config defaults
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'REJECT'
    option synflood_protect '1'
    option flow_offloading '1'
    option flow_offloading_hw '1'

config zone
    option name 'trusted'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    list network 'core'
    list network 'trusted'

config zone
    option name 'untrusted'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    list network 'untrusted'

config zone
    option name 'untrusted_ofln'
    option input 'ACCEPT'
    option output 'ACCEPT'
    option forward 'ACCEPT'
    list network 'untrusted_ofln'

config forwarding
    option src 'trusted'
    option dest 'untrusted'

config forwarding
    option src 'trusted'
    option dest 'untrusted_ofln'
