
config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1/8'

config globals 'globals'
    option packet_steering '1'

config device
    option name 'br-lan'
    option type 'bridge'
    list ports 'lan1'
    list ports 'lan2'
    list ports 'lan3'
    list ports 'lan4'
    list ports 'wan'

config interface 'lan'
    option device 'br-lan.1'
    option proto 'static'
    option ip6assign '60'
    option gateway '10.20.0.1'
    list dns '10.20.0.1'
    list ipaddr '10.20.0.3/16'
    option multipath 'off'

config bridge-vlan
    option device 'br-lan'
    option vlan '1'
    list ports 'lan1:u*'
    list ports 'lan2:u*'
    list ports 'lan3:u*'
    list ports 'lan4:u*'
    list ports 'wan:t'

config bridge-vlan
    option device 'br-lan'
    option vlan '10'
    list ports 'wan:t'

config bridge-vlan
    option device 'br-lan'
    option vlan '20'
    list ports 'wan:t'

config device
    option type '8021q'
    option ifname 'br-lan'
    option vid '1'
    option name 'br-lan.1'

