config dnsmasq
    # Disable DNS, that's run by bind9
    option port '0'
    option leasefile '/tmp/dhcp.leases'
    option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'

config dhcp 'trusted'
    option interface 'trusted'
    # Some hosts have lower lease times (to detect DHCP misconfigurations
    # faster), but keep the default high so that in the event of a breakage,
    # things keep working for 12h.
    option leasetime '12h'
    option dhcpv4 'server'
    # Default router/last resort gateway is this device.
    #list dhcp_option '3,10.20.0.1'
    # DNS is this device.
    #list dhcp_option '6,10.20.0.1'

    # ipv6 config
    option ra 'server'
    option ra_slaac '1'
    # Announce this interface's address as the IPv6 DNS server.
    option dns_service '1'
    option ra_preference 'medium'

config odhcpd 'odhcpd'
    option maindhcp '0'
    option leasefile '/tmp/odhcpd.leases'
    option leasetrigger '/usr/sbin/odhcpd-update'
    option piodir '/tmp/odhcpd-piodir'
    option hostsdir '/tmp/hosts'

config dhcp 'wan'
    option interface 'wan'
    option ignore '1'

config boot 'linux'
    option filename 'netboot.xyz.efi'
    option serveraddress '10.20.10.98'
    option servername 'warthog'

# I don't like doing static leases, but warthog needs a fixed IP
# so it can be routed to for IPv4 port-forwarding. Letsencrypt seems to
# prefer IPv4 rather than failing over to IPv6, so I need NAT
# port-forwarding to work.
config host
    option name 'warthog'
    option mac '00:30:59:28:d0:00'
    option ip '10.20.10.98'
