config softflowd
    option enabled        '1'
    option interface      'br-lan.1'
    option host_port      '10.20.10.98:2055'
    option max_flows      '8192'
    option timeout        'maxlife=5m'
    option pid_file       '/var/run/softflowd.1.pid'
    option control_socket '/var/run/softflowd.1.ctl'
    option export_version '10'
