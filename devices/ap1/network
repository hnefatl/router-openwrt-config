
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option type 'bridge'
	option proto 'static'
	option ip6assign '60'
	option netmask '255.255.0.0'
	option ipaddr '10.20.0.2'
	option ifname 'eth0 eth0.1'
	list dns '10.20.0.1'
	option gateway '10.20.0.1'

config switch
	option name 'switch0'
	option reset '1'

