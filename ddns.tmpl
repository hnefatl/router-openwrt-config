
config ddns 'global'
	option ddns_dateformat '%F %R'
	option ddns_loglines '250'
	option ddns_rundir '/var/run/ddns'
	option ddns_logdir '/var/log/ddns'
	option cacert '/etc/ssl/certs'

config service 'ha_ipv4'
	option enabled '1'
	option service_name 'google.com'
	option username '${ha_ipv4_username}'
	option password '${ha_ipv4_password}'
	option use_https '1'
	option cacert '/etc/ssl/certs'
	option domain 'ha.keith.collister.xyz'
	option lookup_host 'ha.keith.collister.xyz'
	option ip_source 'network'
	option ip_network 'wan'
	option interface 'wan'

config service 'ha_wildcard_ipv4'
	option enabled '1'
	option service_name 'google.com'
	option username '${ha_wildcard_ipv4_username}'
	option password '${ha_wildcard_ipv4_password}'
	option use_https '1'
	option cacert '/etc/ssl/certs'
	option domain '*.ha.keith.collister.xyz'
	option lookup_host 'ddns-test.ha.keith.collister.xyz'
	option ip_source 'network'
	option ip_network 'wan'
	option interface 'wan'

