
config ddns 'global'
    option ddns_dateformat '%F %R'
    option ddns_loglines '250'
    option ddns_rundir '/var/run/ddns'
    option ddns_logdir '/var/log/ddns'
    option cacert '/etc/ssl/certs'

config service "external_ipv4_keithdns"
        option enabled          "0"
        option domain           "keithdns.duckdns.org"
        option service_name     'duckdns.org'
        option username         "keithdns"
        option password         "$external_dns_keithdns_ipv4_password"
        option ip_source        "network"
        option ip_network       "wan"
        option interface        'wan'
        option force_interval   "72"
        option force_unit       "hours"
        option check_interval   "10"
        option check_unit       "minutes"
        option update_url       "http://www.duckdns.org/update?domains=[USERNAME]&token=[PASSWORD]&ip=[IP]"
        #option use_https       "1"

