
config ddns 'global'
    option ddns_dateformat '%F %R'
    option ddns_loglines '250'
    option ddns_rundir '/var/run/ddns'
    option ddns_logdir '/var/log/ddns'
    option cacert '/etc/ssl/certs'

config service 'external_dns_ipv4'
    option enabled '1'
    option service_name 'google.com'
    option username '${external_dns_ipv4_username}'
    option password '${external_dns_ipv4_password}'
    option use_https '1'
    option cacert '/etc/ssl/certs'
    option domain 'keithdns.collister.xyz'
    option lookup_host 'keithdns.collister.xyz'
    option ip_source 'network'
    option ip_network 'wan'
    option interface 'wan'

config service 'vpn_ipv4'
    option enabled '1'
    option service_name 'google.com'
    option username '${vpn_ipv4_username}'
    option password '${vpn_ipv4_password}'
    option use_https '1'
    option cacert '/etc/ssl/certs'
    option domain 'vpn.keith.collister.xyz'
    option lookup_host 'vpn.keith.collister.xyz'
    option ip_source 'network'
    option ip_network 'wan'
    option interface 'wan'
