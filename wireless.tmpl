config wifi-device 'radio0'
	option type 'mac80211'
	option hwmode '11a'
	option path '18000000.axi/bcma0:7/pci0000:00/0000:00:00.0/0000:01:00.0'
	option htmode 'VHT80'
	option country 'CH'
	option cell_density '0'
	option channel 'auto'
	# This radio seems to only support channel 149+, which aren't legal in
	# CH...
	option disabled '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option hwmode '11g'
	option path '18000000.axi/bcma0:8/pci0001:00/0001:00:00.0/0001:01:00.0/0001:02:01.0/0001:03:00.0'
	option htmode 'HT20'
	option country 'CH'
	option cell_density '0'
	option channel '13'

config wifi-device 'radio2'
	option type 'mac80211'
	option hwmode '11a'
	option path '18000000.axi/bcma0:8/pci0001:00/0001:00:00.0/0001:01:00.0/0001:02:02.0/0001:04:00.0'
	option country 'CH'
	option cell_density '0'
	# Not ideal, but channel 36+width 20MHz seems to be the only settings
	# my R8000 supports...... Wider channels ~= faster, which is a shame to
	# be missing out on.
	option htmode 'VHT20'
	option channel '36'

config wifi-iface 'wifinet4'
	option device 'radio1'
	option mode 'ap'
	option ssid '${ssid_2g}'
	option encryption 'psk2'
	option key '${passphrase_2g}'
	option network 'lan'

config wifi-iface 'wifinet1'
	option device 'radio2'
	option mode 'ap'
	option ssid '${ssid_5g}'
	option encryption 'psk2'
	option key '${passphrase_5g}'
	option network 'lan'

