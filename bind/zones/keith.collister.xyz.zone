$TTL 3600

@               IN NS      keithdns.collister.xyz.
@               IN SOA     keithdns.collister.xyz. hnefatl.gmail.com. (
                             1    ; serial number
                             1h   ; refresh after
                             30m  ; retry after
                             1w   ; expire after
                             10m  ; negative cache ttl
                           )

; personal subdomain on GCP appengine. The appengine setup says to use a CNAME,
; but we can't CNAME the apex of an NS... setting the IPs appears to work.
@               IN A       216.239.32.21
@               IN A       216.239.34.21
@               IN A       216.239.36.21
@               IN A       216.239.38.21
@               IN AAAA    2001:4860:4802:32::15
@               IN AAAA    2001:4860:4802:34::15
@               IN AAAA    2001:4860:4802:36::15
@               IN AAAA    2001:4860:4802:38::15

; GCE instance
valheim         IN A       34.105.206.3
minecraft       IN A       35.214.123.194

; Blog
blog            IN CNAME   hnefatl.github.io.

; ipv6 addresses since these should be static/dynamic dns plugin doesn't
; support? should maybe double-check now on bind9.
;warthog         IN AAAA    2a02:169:5bef::2a2
;*.warthog       IN AAAA    2a02:169:5bef::2a2
;ha              IN AAAA    2a02:169:5bef::2a2
;*.ha            IN AAAA    2a02:169:5bef::2a2
